# Environment Configuration for Open Digital Mate

# Composio Integration (REQUIRED for daily digest)
# Get your API key from https://app.composio.dev
COMPOSIO_API_KEY=your_composio_api_key_here

# Composio Entity ID (optional, defaults to 'default')
# Each user should have a unique entity ID
COMPOSIO_ENTITY_ID=default

# Daily Digest Schedule (optional, defaults to 08:00)
# Format: HH:MM in 24-hour format
DIGEST_SCHEDULE=08:00

# Enable/disable daily digest push (optional, defaults to true)
ENABLE_DIGEST=true

# Server Port (optional, defaults to 7777)
PORT=7777

# Data Directory (optional, defaults to ./.odm-data)
ODM_HOME=./.odm-data

# Feishu/Lark Configuration (for bot integration)
# FEISHU_APP_ID=your_app_id
# FEISHU_APP_SECRET=your_app_secret
