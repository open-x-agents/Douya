# Environment Configuration for Open Digital Mate
# Prefer: save keys in the 配置 UI after `npm start` (written to .odm-data/config.json).
# start-dsh.mjs reads that file and exports the right provider env vars for Chief.

# --- LLM (required for chat) ---
# DeepSeek (recommended): either set this, or choose DeepSeek in 配置 and save.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Also accepted (OpenAI-compatible path / Muse digest LLM):
# OPENAI_API_KEY=your_key_here
# OPENAI_BASE_URL=https://api.deepseek.com

# --- Composio (required for digest / 信源) ---
# Get your API key from https://app.composio.dev
COMPOSIO_API_KEY=your_composio_api_key_here
COMPOSIO_ENTITY_ID=default

# Daily Digest Schedule (optional, defaults to 08:00)
DIGEST_SCHEDULE=08:00
ENABLE_DIGEST=true

# Server Port (optional, defaults to 7777) — binds to 127.0.0.1 only
PORT=7777

# Data Directory (optional, defaults to ./.odm-data)
# ODM_HOME=./.odm-data

# --- OpenViking long-term memory (required for chat recall + preferred for Memories glimpse) ---
# Local default needs no key. Remote/managed: set URL + API key.
# OPENVIKING_URL=http://127.0.0.1:1933
# OPENVIKING_API_KEY=
# OPENVIKING_ACCOUNT=
# OPENVIKING_USER=
# Prefer ~/.openviking/ovcli.conf for the same values (shared with `ov` CLI / dsh plugin).
