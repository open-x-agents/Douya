{
  "name": "douya-desktop",
  "productName": "Douya",
  "version": "0.1.0",
  "private": true,
  "description": "Douya / \u8c46\u82bd desktop shell (Electron) for Windows, macOS, and Linux \u2014 opens the local Douya server in one window.",
  "type": "module",
  "main": "src/main.js",
  "author": {
    "name": "open-x-agents",
    "email": "birfychen@gmail.com"
  },
  "homepage": "https://github.com/open-x-agents/openDigitalMate",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "electron .",
    "build:mac": "electron-builder --mac --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:dir": "electron-builder --dir --publish never",
    "bundle:runtime": "node ./scripts/bundle-app-runtime.mjs"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "ai.opendigitalmate.douya",
    "productName": "Douya",
    "copyright": "Apache-2.0 \u00b7 open-x-agents",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Douya uses the microphone only when you press the mic button to talk. \u8c46\u82bd\u53ea\u5728\u4f60\u6309\u4e0b\u9ea6\u514b\u98ce\u6309\u94ae\u8bf4\u8bdd\u65f6\u4f7f\u7528\u9ea6\u514b\u98ce\u3002"
      },
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Douya"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signtoolOptions": {
        "publisherName": "Douya (self-signed)"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Douya"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "executableName": "douya",
      "maintainer": "open-x-agents <birfychen@gmail.com>"
    },
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "app-runtime/**"
        ]
      }
    ]
  }
}
