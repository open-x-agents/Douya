{
  "name": "opendigitalmate",
  "version": "0.1.0",
  "description": "Open Digital Mate: Feishu-native teammate on ds-bot \u2014 digests, calendar, actions; Muse UI is the separate dsh-muse-ui plugin",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./panel": "./src/host/panel.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "src/",
    "README.md",
    "vendor/ds-bot/",
    "docs/"
  ],
  "scripts": {
    "test": "node --test 'test/**/*.test.js' 'acceptance-cases/**/*.test.js'",
    "start": "node scripts/start-dsh.mjs",
    "start:dsbot": "dsh --profile odm --no-open --port 7777",
    "dev": "node scripts/server.js 7777",
    "demo": "node scripts/demo.mjs",
    "start:standalone": "node scripts/server.js"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "feishu",
    "daily-report",
    "reminder"
  ],
  "peerDependencies": {
    "ds-bot": ">=0.2.4",
    "dsh-muse-ui": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "ds-bot": {
      "optional": true
    },
    "dsh-muse-ui": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@larksuiteoapi/node-sdk": "^1.40.0"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "playwright": "^1.64.1",
    "dsh-muse-ui": "file:packages/dsh-muse-ui"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
