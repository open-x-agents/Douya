{
  "name": "dsh-muse-ui",
  "version": "0.1.0",
  "description": "Muse (豆芽) shell for DeepSeek Harness — Today · Memories/Recall · Sources; replaces the stock dsh web shell",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./static-serve": "./static-serve.js",
    "./memory-present": "./memory-present.js"
  },
  "files": [
    "README.md",
    "client.js",
    "cordis.patch.yml",
    "index.js",
    "memory-present.js",
    "static-serve.js",
    "static/"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "muse",
    "douya"
  ],
  "license": "Apache-2.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
